{
  "version": 1,
  "about": "가이드(단계별 진행) 데이터. kinds: 시작 선택지. steps: 순서대로 보여줄 카드. when 으로 어떤 선택/체크에서 나올지 정하고, ops 는 [넣기] 버튼이 적용할 패치 명령(좌표는 뼈대 템플릿 기준).",
  "kinds": [
    {
      "id": "web",
      "name": "웹 서비스",
      "desc": "사용자 → 로드밸런서 → 앱 서버 → DB. 제안서에서 가장 흔한 형태입니다.",
      "template": "skeleton-2az",
      "incremental": true
    },
    {
      "id": "api",
      "name": "서버리스 API",
      "desc": "서버 없이 API Gateway + Lambda + DynamoDB 로 구성합니다.",
      "template": "serverless-api"
    },
    {
      "id": "static",
      "name": "정적 사이트",
      "desc": "Route 53 + CloudFront + S3 로 구성하는 랜딩·홍보 페이지입니다.",
      "template": "static-site"
    },
    {
      "id": "hybrid",
      "name": "온프레미스 연결",
      "desc": "사내 데이터센터와 AWS 를 VPN·전용선으로 연결합니다.",
      "template": "hybrid"
    }
  ],
  "flags": [
    {
      "id": "multiAz",
      "name": "장애 시에도 서비스 유지 (멀티 AZ)",
      "default": true,
      "note": "AZ 두 곳에 같은 구성을 두면 한 곳에 장애가 나도 서비스가 유지됩니다. 대부분의 경우 켜 두는 것을 권장합니다."
    },
    {
      "id": "waf",
      "name": "웹 공격 방어 (WAF)",
      "default": false,
      "note": "SQL 인젝션·봇 같은 웹 공격을 막는 방화벽입니다. 공공·금융 사업이나 개인정보를 다루는 경우 대부분 필수입니다."
    },
    {
      "id": "cdn",
      "name": "정적 콘텐츠 CDN (CloudFront)",
      "default": false,
      "note": "이미지·JS 같은 정적 파일을 전 세계 엣지에서 제공하므로 응답이 빠르고 서버 부하도 줄어듭니다."
    },
    {
      "id": "privacy",
      "name": "개인정보 저장 암호화 (KMS)",
      "default": false,
      "note": "DB 와 저장소를 KMS 키로 암호화합니다. 개인정보 관련 요건이 있으면 켜 두십시오."
    },
    {
      "id": "dr",
      "name": "재해 복구 (다른 리전 DR)",
      "default": false,
      "note": "리전 전체 장애에 대비합니다. 복구 시간 요건(RTO)이 있으면 켜 두십시오."
    },
    {
      "id": "budget",
      "name": "예산 빠듯함",
      "default": false,
      "note": "비용을 줄일 수 있는 선택지를 단계마다 알려 드립니다."
    }
  ],
  "steps": [
    {
      "id": "entry",
      "when": {
        "kind": [
          "web"
        ]
      },
      "title": "진입점: 사용자 → 인터넷 게이트웨이 → 로드밸런서",
      "why": "밖에서 들어오는 길은 하나로 모읍니다. 인터넷 게이트웨이(IGW)가 VPC 의 대문이고, ALB 가 요청을 여러 서버에 분산합니다. 서버에 직접 연결하면 서버 하나에 장애가 날 때 서비스가 함께 중단됩니다.",
      "ops": [
        {
          "op": "add_node",
          "id": "users",
          "icon": "Res_Users_Light",
          "label": "Users",
          "x": -130,
          "y": 300
        },
        {
          "op": "add_node",
          "id": "igw",
          "icon": "Res_Amazon-VPC_Internet-Gateway",
          "label": "Internet Gateway",
          "parent": "vpc",
          "x": 446,
          "y": 4
        },
        {
          "op": "add_node",
          "id": "alb",
          "icon": "Res_Elastic-Load-Balancing_Application-Load-Balancer",
          "label": "Application Load Balancer",
          "parent": "vpc",
          "x": 446,
          "y": 150
        },
        {
          "op": "connect",
          "source": "users",
          "target": "igw",
          "shape": "elbow"
        },
        {
          "op": "connect",
          "source": "igw",
          "target": "alb"
        }
      ]
    },
    {
      "id": "nat",
      "when": {
        "kind": [
          "web"
        ]
      },
      "title": "Public 서브넷에 NAT 게이트웨이",
      "why": "Private 서브넷의 서버는 인터넷에서 직접 접근할 수 없지만, 패치 다운로드처럼 외부로 나가야 할 때가 있습니다. 그 길이 NAT 게이트웨이고, Public 서브넷에 두어야 IGW 로 나갈 수 있습니다.",
      "tip": {
        "flag": "budget",
        "text": "NAT 는 시간당 요금 + 데이터 처리비가 나갑니다. 예산이 빠듯하면 한 개만 두는 방안도 있습니다(대신 그 AZ 에 장애가 나면 아웃바운드가 끊깁니다)."
      },
      "ops": [
        {
          "op": "add_node",
          "id": "nat-a",
          "icon": "Res_Amazon-VPC_NAT-Gateway",
          "label": "NAT Gateway",
          "parent": "pub-a",
          "x": 170,
          "y": 70
        },
        {
          "op": "add_node",
          "id": "nat-b",
          "icon": "Res_Amazon-VPC_NAT-Gateway",
          "label": "NAT Gateway",
          "parent": "pub-b",
          "x": 170,
          "y": 70,
          "when": {
            "flag": "multiAz"
          }
        }
      ]
    },
    {
      "id": "app",
      "when": {
        "kind": [
          "web"
        ]
      },
      "title": "앱 서버는 Private 서브넷에, Auto Scaling 으로",
      "why": "서버는 인터넷에서 안 보이는 Private 서브넷에 두고 ALB 만 앞에 둡니다. Auto Scaling 그룹으로 묶으면 트래픽에 따라 대수가 늘고 줄어 피크 때도 견디고 평소에는 비용을 아낍니다.",
      "ops": [
        {
          "op": "add_group",
          "id": "asg",
          "kind": "auto-scaling",
          "label": "Auto Scaling group",
          "parent": "vpc",
          "x": 40,
          "y": 362,
          "w": 920,
          "h": 118
        },
        {
          "op": "add_node",
          "id": "web-a",
          "icon": "Res_Amazon-EC2_Instance",
          "label": "Web/App EC2",
          "parent": "priv-a",
          "x": 100,
          "y": 50
        },
        {
          "op": "add_node",
          "id": "web-b",
          "icon": "Res_Amazon-EC2_Instance",
          "label": "Web/App EC2",
          "parent": "priv-b",
          "x": 100,
          "y": 50,
          "when": {
            "flag": "multiAz"
          }
        },
        {
          "op": "connect",
          "source": "alb",
          "target": "web-a",
          "shape": "elbow"
        },
        {
          "op": "connect",
          "source": "alb",
          "target": "web-b",
          "shape": "elbow",
          "when": {
            "flag": "multiAz"
          }
        }
      ]
    },
    {
      "id": "db",
      "when": {
        "kind": [
          "web"
        ]
      },
      "title": "DB 는 Private 서브넷에, 대기 복제본과 함께",
      "why": "DB 는 절대 인터넷에 노출하지 않습니다. 앱 서버가 있는 Private 서브넷(또는 별도 DB 서브넷)에 두고, Multi-AZ 로 다른 AZ 에 대기(Standby) 복제본을 두면 장애 시 자동으로 넘어갑니다.",
      "ops": [
        {
          "op": "add_node",
          "id": "rds-primary",
          "icon": "Res_Amazon-Aurora_Amazon-RDS-Instance",
          "label": "RDS (Primary)",
          "parent": "priv-a",
          "x": 290,
          "y": 110
        },
        {
          "op": "add_node",
          "id": "rds-standby",
          "icon": "Res_Amazon-Aurora_Amazon-RDS-Instance",
          "label": "RDS (Standby)",
          "parent": "priv-b",
          "x": 290,
          "y": 110,
          "when": {
            "flag": "multiAz"
          }
        },
        {
          "op": "connect",
          "source": "web-a",
          "target": "rds-primary",
          "shape": "elbow"
        },
        {
          "op": "connect",
          "source": "web-b",
          "target": "rds-primary",
          "shape": "elbow",
          "when": {
            "flag": "multiAz"
          }
        },
        {
          "op": "connect",
          "source": "rds-primary",
          "target": "rds-standby",
          "label": "동기 복제",
          "line": "dashed",
          "when": {
            "flag": "multiAz"
          }
        }
      ]
    },
    {
      "id": "waf",
      "when": {
        "kind": [
          "web"
        ],
        "flag": "waf"
      },
      "title": "WAF 로 웹 공격 막기",
      "why": "WAF 는 ALB(또는 CloudFront) 앞에 붙는 웹 방화벽입니다. SQL 인젝션, XSS, 악성 봇을 규칙으로 거릅니다. 요건서에 '보안' '개인정보' 글자가 있으면 거의 필수로 넣습니다.",
      "ops": [
        {
          "op": "add_node",
          "id": "waf",
          "icon": "Arch_AWS-WAF",
          "label": "AWS WAF",
          "x": -130,
          "y": 160
        },
        {
          "op": "connect",
          "source": "waf",
          "target": "alb",
          "label": "웹 ACL",
          "line": "dashed",
          "arrow": "none",
          "shape": "elbow"
        }
      ]
    },
    {
      "id": "cdn",
      "when": {
        "kind": [
          "web"
        ],
        "flag": "cdn"
      },
      "title": "CloudFront 로 정적 콘텐츠 배포",
      "why": "이미지·CSS·JS 같은 정적 파일은 S3 에 두고 CloudFront(CDN)가 전 세계 엣지에서 제공합니다. 사용자 응답은 빨라지고 앱 서버는 동적 요청만 받아서 가벼워집니다. 피크 트래픽 흡수에도 큰 도움이 됩니다.",
      "ops": [
        {
          "op": "add_node",
          "id": "cloudfront",
          "icon": "Arch_Amazon-CloudFront",
          "label": "Amazon CloudFront",
          "x": -130,
          "y": 460
        },
        {
          "op": "add_node",
          "id": "s3-static",
          "icon": "Arch_Amazon-Simple-Storage-Service",
          "label": "S3 (정적 콘텐츠)",
          "x": -130,
          "y": 600
        },
        {
          "op": "disconnect",
          "source": "users",
          "target": "igw"
        },
        {
          "op": "connect",
          "source": "users",
          "target": "cloudfront"
        },
        {
          "op": "connect",
          "source": "cloudfront",
          "target": "igw",
          "label": "동적 요청",
          "shape": "elbow"
        },
        {
          "op": "connect",
          "source": "cloudfront",
          "target": "s3-static",
          "label": "정적"
        }
      ]
    },
    {
      "id": "privacy",
      "when": {
        "kind": [
          "web"
        ],
        "flag": "privacy"
      },
      "title": "저장 데이터 암호화 (KMS)",
      "why": "개인정보는 '저장할 때 암호화'가 기본 요건입니다. RDS 와 S3 에 KMS 키를 걸면 디스크가 통째로 유출되어도 읽을 수 없습니다. 다이어그램에는 KMS 아이콘과 점선으로 '암호화됨'을 표시합니다.",
      "ops": [
        {
          "op": "add_node",
          "id": "kms",
          "icon": "Arch_AWS-Key-Management-Service",
          "label": "AWS KMS",
          "x": -130,
          "y": 740
        },
        {
          "op": "connect",
          "source": "kms",
          "target": "rds-primary",
          "label": "저장 암호화",
          "line": "dashed",
          "arrow": "none",
          "shape": "elbow"
        }
      ]
    },
    {
      "id": "dr",
      "when": {
        "kind": [
          "web"
        ],
        "flag": "dr"
      },
      "title": "다른 리전에 재해 복구(DR) 구성",
      "why": "리전 전체 장애에 대비하려면 다른 리전에 최소 구성(VPC·서브넷·DB 복제본)을 두고 DB 를 복제해 둡니다. 복구 시간 요건(RTO)에 따라 '백업만'(저렴하고 느림)부터 '상시 대기'(비싸고 빠름)까지 수준을 고릅니다.",
      "ops": [
        {
          "op": "add_group",
          "id": "region-dr",
          "kind": "region",
          "label": "DR Region",
          "x": 1080,
          "y": 20,
          "w": 380,
          "h": 300
        },
        {
          "op": "add_group",
          "id": "vpc-dr",
          "kind": "vpc",
          "label": "VPC (DR)",
          "parent": "region-dr",
          "x": 20,
          "y": 44,
          "w": 340,
          "h": 236
        },
        {
          "op": "add_group",
          "id": "az-dr",
          "kind": "az",
          "label": "Availability Zone",
          "parent": "vpc-dr",
          "x": 20,
          "y": 44,
          "w": 300,
          "h": 172
        },
        {
          "op": "add_group",
          "id": "priv-dr",
          "kind": "private-subnet",
          "label": "Private subnet",
          "parent": "az-dr",
          "x": 20,
          "y": 40,
          "w": 260,
          "h": 112
        },
        {
          "op": "add_node",
          "id": "rds-dr",
          "icon": "Res_Amazon-Aurora_Amazon-RDS-Instance",
          "label": "RDS 복제본 (크로스 리전)",
          "parent": "priv-dr",
          "x": 106,
          "y": 40
        },
        {
          "op": "connect",
          "source": "rds-primary",
          "target": "rds-dr",
          "label": "크로스 리전 복제",
          "line": "dashed",
          "shape": "elbow"
        }
      ]
    },
    {
      "id": "review-template",
      "when": {
        "kind": [
          "api",
          "static",
          "hybrid"
        ]
      },
      "title": "기본 구성이 들어갔습니다",
      "why": "이 형태는 뼈대가 곧 완성형이라 템플릿을 통째로 넣었습니다. 라벨을 프로젝트에 맞는 이름으로 바꾸고, 빠진 것이 있으면 왼쪽 팔레트에서 끌어다 넣으십시오. 다음 단계에서 [규칙 검사]와 AI 검수로 빈틈을 잡습니다.",
      "ops": []
    },
    {
      "id": "rules",
      "when": {},
      "kind": "rules",
      "title": "규칙 검사",
      "why": "지금까지 그린 내용을 AWS 기본 규칙에 비추어 [규칙 검사] 결과를 확인하십시오. 차단·경고·참고 항목이 있으면 이유를 읽고 고치고, 없으면 다음 단계로 넘어갑니다."
    },
    {
      "id": "ai",
      "when": {},
      "kind": "ai",
      "title": "AI 검수 (선택)",
      "why": "요건서를 넣어 두었다면 AI 가 요건 대비 빠진 것·과한 것을 짚어 드립니다. AI 가 연결되어 있지 않으면 건너뛰어도 됩니다."
    },
    {
      "id": "export",
      "when": {},
      "kind": "export",
      "title": "내보내기",
      "why": "PNG 로 복사해서 제안서에 붙이거나 SVG 로 저장합니다. EXE 에서는 PowerPoint 편집 도형으로도 들어갑니다."
    }
  ]
}
